    "nuxt": "^4.4.2",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.9.2",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
